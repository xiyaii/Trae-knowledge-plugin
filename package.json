{
  "name": "trae-ask",
  "displayName": "Trae Ask",
  "description": "Trae 企业版智能问答助手 - 快速获取答案",
  "version": "0.1.0",
  "publisher": "trae-cn",
  "icon": "media/icon.jpeg",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiyaii/Trae-knowledge-plugin.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Other"],
  "keywords": ["trae", "ask", "knowledge", "qa", "assistant"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "trae-ask",
          "title": "Trae Ask",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "trae-ask": [
        {
          "type": "webview",
          "id": "traeAsk.chatView",
          "name": "问答"
        }
      ]
    },
    "commands": [
      {
        "command": "traeAsk.openChat",
        "title": "Trae Ask: 打开问答"
      },
      {
        "command": "traeAsk.clearChat",
        "title": "Trae Ask: 清空对话"
      },
      {
        "command": "traeAsk.uninstall",
        "title": "Trae Ask: 卸载插件"
      }
    ],
    "configuration": {
      "title": "Trae Ask",
      "properties": {
        "traeAsk.serviceResourceId": {
          "type": "string",
          "default": "kb-service-39d7c93c630152d",
          "description": "知识服务 ID"
        },
        "traeAsk.maxHistory": {
          "type": "number",
          "default": 10,
          "description": "多轮对话保留的历史轮数"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-webview": "cd webview-ui && npm run build",
    "watch-webview": "cd webview-ui && npm run dev",
    "build-go": "cd go-backend && GOOS=darwin GOARCH=arm64 go build -ldflags \"-X main.kbProxyURL=$(cat ../.kb_proxy_url 2>/dev/null || echo '') -X main.trackEndpoint=$(cat ../.track_endpoint 2>/dev/null || echo '') -X main.trackToken=$(cat ../.track_token 2>/dev/null || echo '')\" -o ../bin/kb-server-darwin-arm64 .",
    "build-all": "npm run build-go && npm run compile-webview && npm run package",
    "package-vsix": "vsce package --skip-license --out Trae_Ask_0.1.0.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.80.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  }
}
